{
  "name": "Zmeika Igra",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "postCreateCommand": "corepack enable && pnpm install --frozen-lockfile",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Zmeika Igra",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "remoteUser": "node"
}
